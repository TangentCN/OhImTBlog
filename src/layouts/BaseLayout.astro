---
// 布局组件：全站统一的 HTML 外壳（head + 顶部导航 + 底部版权）
// 页面通过 <BaseLayout>包裹内容</BaseLayout> 复用这套外壳

interface Props {
  title?: string;
  description?: string;
}

const { title = "OhImT Blog", description = "" } = Astro.props;

// 当前页路径检测：用于顶部导航「当前页高亮」
// Astro.url.pathname 是浏览器地址，如 "/" 或 "/blog/my-first-post/"
const currentPath = Astro.url.pathname;
const isBlog = currentPath.startsWith("/blog");

// 引入全局样式。不 import 这一行，Tailwind 完全不生效
import "../styles/global.css";

// 页面切换动画：启用 Astro 内置的 View Transitions（SPA 式导航 + 过渡）
// 组件加在共享布局的 <head> 里 → 全站所有页面生效
import { ClientRouter, slide } from "astro:transitions";

// 注：模板区 <slot /> 是"插座"，子页面包裹的内容会填进这里
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <!-- 全站背景图：铺满视口、居中、滚动时固定；bg-page 作加载失败的底色兜底 -->
  <body class="bg-[url('/bg.png')] bg-cover bg-center bg-fixed bg-page text-ink antialiased">
    <!-- 外层包裹（header + 内容区）：整体至少一屏高，footer 紧跟其外、顶部恰落在首屏底部线 -->
    <div class="flex min-h-screen flex-col">
      <!-- 毛玻璃 header：sticky 固定在顶、半透明背景 + backdrop-blur，滚动时内容在 header 后模糊 -->
      <header class="sticky top-0 z-20 border-line bg-page/5 backdrop-blur-md">
        <!-- 外层包裹：移动端 flex 两端布局（站名左、导航右，避免窄屏重叠）；桌面导航 absolute 居中 -->
        <div class="relative flex items-center px-4 md:px-8">
          <!-- 站名：移动端小号紧凑，桌面恢复原字号 -->
          <a href="/" class="inline-block py-5 text-[22px] font-bold hover:text-accent md:py-6 md:text-[25px]">OhImT</a>
          <!-- 导航：移动端 ml-auto 推到最右（两端对齐）；桌面 absolute 相对外层 div 水平垂直居中 -->
          <nav class="relative ml-auto flex items-center gap-4 text-[15px] md:absolute md:left-1/2 md:top-1/2 md:ml-0 md:-translate-x-1/2 md:-translate-y-1/2 md:gap-5 md:text-[18px]">
            <a
              href="/"
              class={currentPath === "/" ? "text-accent font-bold" : "text-soft font-bold hover:text-accent-soft"}
            >Home</a>
            <a
              href="/blog/"
              class={isBlog ? "text-accent font-bold" : "text-soft font-bold hover:text-accent-soft"}
            >Articles</a>
          </nav>
        </div>
      </header>

      <!-- flex-1：内容区在包裹内撑满剩余高度，footer 被顶到首屏底部线之下 -->
      <!-- transition:animate="slide"：内容区前进时右滑入、返回时反向滑动 -->
      <div class="flex-1" transition:animate={slide({ duration: "0.3s" })}>
        <slot />
      </div>
    </div>

    <footer class="border-line">
      <div class="mx-auto max-w-3xl px-4 py-8 text-center text-sm text-accent">
        © {new Date().getFullYear()} OhImT
      </div>
    </footer>
  </body>
</html>

<script>
  // 方向感知滑动：目标页面在导航条哪一侧，就从哪一侧滑入
  // astro:before-preparation 在每次导航前触发，改它的 direction 即可改变滑动方向
  document.addEventListener("astro:before-preparation", (event) => {
    // event.to 是目标 URL；/blog/*（文章/详情）在导航右侧，其余（首页）在左侧
    event.direction = event.to.pathname.startsWith("/blog") ? "forward" : "back";
  });
</script>
