---
// 布局组件：全站统一的 HTML 外壳（head + 顶部导航 + 底部版权）
// 页面通过 <BaseLayout>包裹内容</BaseLayout> 复用这套外壳

interface Props {
  title?: string;
  description?: string;
}

const { title = "OhImT 的博客", description = "" } = Astro.props;

// 当前页路径检测：用于顶部导航「当前页高亮」
// Astro.url.pathname 是浏览器地址，如 "/" 或 "/blog/my-first-post/"
const currentPath = Astro.url.pathname;
const isBlog = currentPath.startsWith("/blog");

// 引入全局样式。不 import 这一行，Tailwind 完全不生效
import "../styles/global.css";

// 注：模板区 <slot /> 是"插座"，子页面包裹的内容会填进这里
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-gray-950 text-gray-100 antialiased">
    <header class="border-b border-gray-800">
      <div class="mx-auto flex max-w-2xl items-center justify-between px-4 py-6">
        <a href="/" class="text-xl font-bold hover:text-blue-400">OhImT 的博客</a>
        <nav class="flex items-center gap-5 text-sm">
          <a
            href="/"
            class={currentPath === "/" ? "text-blue-400" : "text-gray-300 hover:text-blue-400"}
          >首页</a>
          <a
            href="/blog/"
            class={isBlog ? "text-blue-400" : "text-gray-300 hover:text-blue-400"}
          >文章</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t border-gray-800">
      <div class="mx-auto max-w-2xl px-4 py-8 text-sm text-gray-400">
        © {new Date().getFullYear()} OhImT 的博客
      </div>
    </footer>
  </body>
</html>
