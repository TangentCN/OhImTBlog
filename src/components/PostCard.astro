---
// 文章卡片：首页列表里的一篇文章
// CollectionEntry<"blog"> 是 Astro 根据内容集合自动生成的类型，
// 它保证 post.data / post.id 都是合法的（写错会报错）
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
// 注：post.id 就是文件名（不含 .md），它决定详情页 URL：/blog/文件名/
---
<article class="relative rounded-4xl border border-line bg-page/30 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-[2px] hover:bg-page/50 hover:border-accent/40">
  <h2 class="text-xl font-semibold">
    <!-- after:absolute + inset-0：伪元素铺满整张卡片，点击卡片任意处 = 点击链接（stretched link） -->
    <a href={`/blog/${post.id}/`} class="hover:text-accent after:absolute after:inset-0 after:content-['']">{post.data.title}</a>
  </h2>
  <time class="text-sm text-muted">{post.data.pubDate.toLocaleDateString()}</time>
  {post.data.description && <p class="mt-2 text-soft">{post.data.description}</p>}
</article>
