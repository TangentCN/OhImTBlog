---
// 文章卡片：首页列表里的一篇文章
// CollectionEntry<"blog"> 是 Astro 根据内容集合自动生成的类型，
// 它保证 post.data / post.id 都是合法的（写错会报错）
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
// 注：post.id 就是文件名（不含 .md），它决定详情页 URL：/blog/文件名/

// 字数统计：post.body 是 Markdown 原始文本，去掉所有空白后统计字符数（中文按字、英文按字符）
const wordCount = (post.body ?? "").replace(/\s/g, "").length;
---
<article class="relative rounded-4xl border border-line bg-page/30 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-[2px] hover:bg-page/50 hover:border-accent/40">
  <!-- 日期 + 标签 + 字数：放在标题和简介上方（参考 novic.cc 卡片布局；同一行小字灰字，tags 用「 / 」分隔） -->
  <div class="flex flex-wrap items-center gap-2 text-[11px] text-muted">
    <time>{post.data.pubDate.toLocaleDateString()}</time>
    {post.data.tags.length > 0 && (
      <span>· {post.data.tags.join(" / ")}</span>
    )}
    <span>· {wordCount} 字</span>
  </div>
  <h2 class="mt-2 text-[17px] font-semibold">
    <!-- after:absolute + inset-0：伪元素铺满整张卡片，点击卡片任意处 = 点击链接（stretched link） -->
    <a href={`/blog/${post.id}/`} class="hover:text-accent after:absolute after:inset-0 after:content-['']">{post.data.title}</a>
  </h2>
  {post.data.description && <p class="mt-2 text-[13px] text-soft">{post.data.description}</p>}
</article>
