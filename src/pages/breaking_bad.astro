---
// 彩蛋页面：无任何外链指向，只能通过直接输入地址访问（/breaking_bad/）
// 内容：public/ascii_art.txt 的 ASCII 字符画，构建时用 fs 读取
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from "node:fs";
// 构建时读取 ASCII 字符画文件（路径相对项目根）
const art = fs.readFileSync("public/ascii_art.txt", "utf-8");
---

<BaseLayout title="🎉">
  <main class="mx-auto max-w-5xl px-4 py-10">
    <!-- pre 保留空格/换行；overflow-x-auto 窄屏可横向滚动 -->
    <pre class="overflow-x-auto font-mono leading-snug text-ink/80">{art}</pre>
  </main>
</BaseLayout>
