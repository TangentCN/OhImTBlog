---
// 彩蛋页面：无任何外链指向，只能通过直接输入地址访问（/breaking_bad/）
// 独立页面（不用 BaseLayout）：body 用 page 令牌色作纯色背景
import "../styles/global.css"; // 引入 Tailwind + 配色令牌
import fs from "node:fs";

// 构建时读取 ASCII 字符画文件（路径相对项目根）
const art = fs.readFileSync("public/ascii_art.txt", "utf-8");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>🎉</title>
  </head>
  <!-- flex 居中：items-center 垂直居中 + justify-center 水平居中 -->
  <body class="flex min-h-screen items-center justify-center bg-page text-ink antialiased">
    <!-- pre 用 w-max：宽度 = 内容最宽行，字符画完整显示（不内部滚动） -->
    <pre class="w-max font-mono leading-snug text-ink/80">{art}</pre>
    <!-- 音频：不设 loop 即只播一次；不用 autoplay（会被浏览器拦截），改为首次交互触发播放 -->
    <audio id="egg-audio" src="/bitch.mp3" preload="auto"></audio>
  </body>
</html>

<script>
  // 浏览器拦截无用户交互的自动播放：监听首次点击/按键后播放（{ once: true } 只触发一次）
  const audio = document.getElementById("egg-audio") as HTMLAudioElement | null;
  if (audio) {
    window.addEventListener("pointerdown", () => audio.play(), { once: true });
  }
</script>
