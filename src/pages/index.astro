---
// 极简主页：一句话介绍 + 引导去文章列表
// 文章列表已移到 /blog/（见 blog/index.astro）
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-3xl font-bold">OhImT 的博客</h1>
    <p class="mt-4 text-soft">这里记录我的技术笔记与生活。</p>
    <a
      href="/blog/"
      class="mt-10 inline-block rounded bg-accent px-6 py-2.5 text-sm font-medium text-on-accent hover:bg-accent-soft"
    >查看全部文章 →</a>
  </main>
</BaseLayout>
