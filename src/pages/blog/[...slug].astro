---
// 文章详情页（动态路由）：
// 文件名里的 [...slug] 表示"这一段的任意值都归这个页面管"，
// 所以 /blog/my-first-post/ 和 /blog/second-post/ 都走这里。
// getStaticPaths 在构建时把每篇文章都变成一个独立 URL（纯静态也能有多个详情页）

import BaseLayout from "../../layouts/BaseLayout.astro";
import TocNav from "../../components/TocNav.astro";
import { getCollection, render } from "astro:content";

// 构建时运行：遍历所有文章，为每篇生成 { params, props }
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id }, // slug 决定 URL（就是文件名）
    props: { post },           // 把整篇文章数据传给当前页面
  }));
}

const { post } = Astro.props;
// render 把 Markdown 编译成一个组件，<Content /> 再把正文"画"到页面上
// render 返回 { Content, headings }：headings 是 Astro 内置提取的标题结构（depth/slug/text），
// 其 slug 与渲染后标题的 id 完全一致（Astro 内置 github-slugger 生成，含同名唯一化）
// headings 传给 TocNav 组件，由组件内部过滤出目录（取 h2 及以上）
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <!-- 文章居中（max-w-3xl）；目录 fixed 固定在视口右侧（不占文档流，不挤压文章） -->
  <main class="mx-auto max-w-3xl px-4 py-10">
    <!-- fixed 浮动返回按钮（参考 novic.cc）：不占文档流，固定在视口左上角，SVG 箭头 -->
    <a
      href="/blog/"
      aria-label="返回文章列表"
      class="back-btn fixed top-30 z-20 hidden h-10 w-10 items-center justify-center rounded-full border border-line bg-page/50 text-ink/80 shadow-lg shadow-black/30 backdrop-blur-md transition-all duration-200 hover:scale-105 hover:bg-white/10 hover:text-accent hover:border-accent/40 active:scale-95 md:flex"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
    </a>

    <article class="prose prose-lg prose-invert">
      <h1>{post.data.title}</h1>
      <p class="text-sm text-muted">{post.data.pubDate.toLocaleDateString()}</p>
      {post.data.tags.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded bg-surface px-2 py-1 text-sm text-soft">{tag}</span>
          ))}
        </div>
      )}
      <Content />
    </article>
    <a href="/blog/" class="mt-8 inline-block text-accent">← 返回文章列表</a>

    <!-- 目录组件：PC 端右侧 dock（hover 唤出 + pin 常驻）+ 移动端抽屉；逻辑见 TocNav.astro -->
    <TocNav headings={headings} />
  </main>
</BaseLayout>

<style>
  /* 返回按钮定位（跟随文章左缘，窗口缩放不漂移）：
     (100vw - 48rem) / 2 = 文章容器左缘（max-w-3xl 居中，48rem=768px）
     + 2.75rem          = 相对文章左缘的基础偏移（原有视觉位置）
     + var(--back-x)    = 额外左右微调：改这一个数即可调节按钮位置（负 = 左移，正 = 右移） */
  .back-btn {
    --back-x: -8rem;
    left: calc((100vw - 48rem) / 2 + 2.75rem + var(--back-x));
  }
</style>
